# Local model configuration. Application/API authentication is intentionally disabled.
# scripts/init_config.py creates .env once; existing settings and credentials are preserved.
# App/web Settings also edits all backend settings and write-only keys. Saved values
# override these initial defaults; see docs/README.md#local-inference.
OMI_DATA_DIR=data
OMI_TIMEZONE=Europe/Copenhagen
# HomeCompute's configured local network gateway; verify on your own network.
OMI_STT_BASE_URL=http://ai.home.arpa:18080/v1
OMI_LLM_BASE_URL=http://ai.home.arpa:18080/v1
OMI_INFERENCE_TOKEN=
# Optional personal Omi developer API key (conversations:read). Leave empty for BLE-only capture.
# Kept on the backend; never returned to the browser or included in archive backups.
OMI_OMI_API_KEY=
# Optional official audio webhook; disabled by default. Saved UI enablement overrides this default.
# Generate a separate secret: uv run python -c 'import secrets; print(secrets.token_urlsafe(32))'
# URL-safe 32–128 characters. Backend-only; never returned in settings or backups.
# Current upstream delivers from Omi's server, which blocks LAN/private VPN destinations.
# See docs/official-audio-forwarding.md before configuring sender reachability; do not expose the UI.
OMI_AUDIO_FORWARDING_ENABLED=false
OMI_AUDIO_FORWARDING_TOKEN=
OMI_STT_MODEL=stt-danish
# Optional language-based STT routes. Unset fields inherit STT_MODEL, STT_BASE_URL,
# and INFERENCE_TOKEN. Choose these languages in web/iPhone Settings for direct routing.
# For automatic routing, first use a multilingual STT that returns language metadata:
# OMI_STT_MODEL=whisper-turbo
# OMI_STT_ROUTES__DA__MODEL=stt-danish
# OMI_STT_ROUTES__EN__MODEL=whisper-turbo
# If detection returns full names, configure matching keys as well:
# OMI_STT_ROUTES__DANISH__MODEL=stt-danish
# Each language also supports BASE_URL and TOKEN; an empty TOKEN removes authentication.
# OMI_STT_ROUTES__DA__BASE_URL=http://danish.local:4000/v1
# OMI_STT_ROUTES__DA__TOKEN=
# Optional AUTO route overrides the initial detector/mixed-language model.
# OMI_STT_ROUTES__AUTO__MODEL=whisper-turbo
OMI_LLM_MODEL=home
# Optional for local models supporting chat_template_kwargs.enable_thinking.
# Disable reasoning when it consumes the output budget before returning an answer.
# OMI_LLM_ENABLE_THINKING=false
# Bump after replacing a model behind an unchanged route to invalidate weekly caches.
OMI_LLM_REVISION=
# Optional per-task overrides. Leave unset to use the shared LLM configuration above.
# Tasks: CHAT, SUMMARY (diary/meeting/rewind and chat evidence reduction), EXTRACTION
# (inbox and decisions), PREPARATION, WEEKLY, RETRIEVAL (missed-query expansion).
# Model aliases must exist on your gateway.
# OMI_LLM_ROUTES__CHAT__MODEL=fast-chat
# OMI_LLM_ROUTES__SUMMARY__MODEL=long-context
# Each task can also override BASE_URL, TOKEN and REVISION independently:
# OMI_LLM_ROUTES__SUMMARY__BASE_URL=http://summarizer.local:4000/v1
# OMI_LLM_ROUTES__SUMMARY__TOKEN=
# OMI_LLM_ROUTES__SUMMARY__REVISION=weights-v2
# A bounded extra query-expansion call is used only when chat finds no evidence and
# searchable transcripts exist in its scope. /v1/search never generates search wording.
OMI_CHAT_QUERY_EXPANSION=true
OMI_CHAT_QUERY_EXPANSION_TIMEOUT_SECONDS=5
# Optional semantic retrieval. Leave disabled until a local embedding model is evaluated.
# The backend uses POST /embeddings; no model is chosen, downloaded or hosted fallback used.
OMI_EMBEDDING_ENABLED=false
OMI_EMBEDDING_BASE_URL=http://127.0.0.1:4000/v1
OMI_EMBEDDING_TOKEN=
OMI_EMBEDDING_MODEL=
# An immutable operator-supplied weights/revision identifier; change it when the alias changes.
OMI_EMBEDDING_REVISION=
OMI_EMBEDDING_DIMENSION=0
# Confirm these character ceilings (including prefixes) fit the model's TOKEN input limit.
OMI_EMBEDDING_PASSAGE_CHARS=1000
OMI_EMBEDDING_MAX_INPUT_CHARS=4000
OMI_EMBEDDING_QUERY_PREFIX=
OMI_EMBEDDING_DOCUMENT_PREFIX=
OMI_EMBEDDING_TIMEOUT_SECONDS=10
# Interactive queries have a shorter total deadline; background indexing keeps the above.
OMI_EMBEDDING_QUERY_TIMEOUT_SECONDS=2
# Query vectors only; no cached transcripts, retrieved sources or answers. RAM-only.
OMI_EMBEDDING_QUERY_CACHE_SIZE=128
OMI_EMBEDDING_QUERY_CACHE_SECONDS=300
# Avoid repeated provider timeouts during an outage; indexing retries remain independent.
OMI_EMBEDDING_QUERY_RETRY_SECONDS=15
# Initial uncalibrated cosine floor; tune on dev cases and report heldout performance.
OMI_EMBEDDING_MIN_SCORE=0.5
OMI_LANGUAGE=auto
OMI_MEETING_MAX_MINUTES=120
OMI_MARKER_CONTEXT_SECONDS=60
OMI_MARKER_AFTER_SECONDS=60
OMI_MARKER_COOLDOWN_SECONDS=60
OMI_MEETING_MIN_SECONDS=60
OMI_MEETING_CONTEXT_SECONDS=60
OMI_RECAP_HOUR=22
OMI_WORKER_ENABLED=true
# Initial retention defaults; saved Settings choices take precedence. Zero keeps indefinitely.
OMI_AUDIO_RETENTION_DAYS=7
OMI_TRANSCRIPT_RETENTION_DAYS=30
