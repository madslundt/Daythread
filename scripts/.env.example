# Copy this file to .env beside import_recordings.py, then edit the values.
# Run: python3 import_recordings.py
# CLI arguments override exported variables, which override this file.

DAYTHREAD_SERVER_URL=https://daythread.home.arpa
DAYTHREAD_PROFILE=default

# Optional bearer token, only if your server or proxy requires authentication.
# DAYTHREAD_IMPORT_TOKEN=replace-with-your-private-token

# Optional generic recording folder. Omit to watch Parrot's recordings.
# DAYTHREAD_IMPORT_FOLDER="~/Recordings"

# Optional private certificate authority used by your Daythread server.
# SSL_CERT_FILE="/path/to/root-ca.crt"
