# Model configuration (local by default). Application/API authentication is intentionally disabled.
# scripts/init_config.py creates .env once; existing settings and credentials are preserved.
# App/web Settings also edits all backend settings and write-only keys. Saved values
# override these initial defaults; see docs/README.md#local-inference.
OMI_DATA_DIR=data
# One backend supports both deployment modes. Managed hosting disables automatic
# audio/transcript deletion even when restored preferences specify retention.
OMI_MANAGED_HOSTING=false
OMI_TIMEZONE=Europe/Copenhagen
# Set STT and LLM endpoints, API keys, models and processing options in
# web/iPhone Settings → Models & server. They persist in .private-settings.json.
# This starter file does not duplicate model settings; legacy environment defaults
# remain supported for existing deployments. See docs/README.md#local-inference.
OMI_INFERENCE_TOKEN=
# Optional personal Omi developer API key (conversations:read). Leave empty for BLE-only capture.
# Kept on the backend; never returned to the browser or included in archive backups.
OMI_OMI_API_KEY=
# Optional official audio webhook; disabled by default. Saved UI enablement overrides this default.
# Generate a separate secret: uv run python -c 'import secrets; print(secrets.token_urlsafe(32))'
# URL-safe 32–128 characters. Backend-only; never returned in settings or backups.
# Current upstream delivers from Omi's server, which blocks LAN/private VPN destinations.
# See docs/official-audio-forwarding.md before configuring sender reachability; do not expose the UI.
OMI_AUDIO_FORWARDING_ENABLED=false
OMI_AUDIO_FORWARDING_TOKEN=
# Optional speaker detection. Names and speaker assignments stay within each conversation.
# The separate runtime uses Python 3.12 because PyTorch is unavailable for Python 3.15.
# Install FFmpeg, then run from the repository root (no models load at startup):
# uv run --no-project --python 3.12 scripts/diarization_server.py
# Runtime variables must be exported in that process; it does not read this .env.
# First accept the model's access conditions and obtain its files, following:
# https://huggingface.co/pyannote/speaker-diarization-community-1#offline-use
# Fully offline: export OMI_DIARIZATION_MODEL_DIR=/absolute/path/to/community-1
# Initial download instead: export OMI_DIARIZATION_ALLOW_DOWNLOAD=true and export
# HF_TOKEN through your secret manager/shell (never save the token in this example).
# It downloads only Community-1 weights and performs inference locally. Telemetry is off.
# OMI_DIARIZATION_DEVICE=cpu (default), cuda or mps; host=127.0.0.1 and port=8790.
# /health reports configured/ready/busy; the first request lazily loads the model.
# Allow a larger deadline for long recordings/CPU inference. Maximum input is eight hours.
# Docker backend: use a host-reachable service address instead of 127.0.0.1.
OMI_DIARIZATION_ENABLED=false
OMI_DIARIZATION_BASE_URL=http://127.0.0.1:8790
OMI_DIARIZATION_TIMEOUT_SECONDS=600
# Optional remembered voices, confined to the selected archive; disabled by default.
# Enable in server settings, then explicitly Remember a speaker in at least two
# independent conversations. Plain names and unconfirmed suggestions never train.
# Suggestions stay OFF until scripts/evaluate_speakers.py produces a passing report
# on separate calibration/test WAV recordings, using the current model/examples.
# See docs/README.md#remembering-speakers-across-conversations and the example manifest.
# Relative report paths resolve inside each selected archive directory. Set an absolute
# path only for one archive; other archives cannot use its gallery-bound report.
# Reports contain voice representations; protect/remove them separately from recordings.
OMI_VOICE_RECOGNITION_ENABLED=false
OMI_VOICE_RECOGNITION_REPORT=
# A bounded extra query-expansion call is used only when chat finds no evidence and
# searchable transcripts exist in its scope. /v1/search never generates search wording.
OMI_CHAT_QUERY_EXPANSION=true
OMI_CHAT_QUERY_EXPANSION_TIMEOUT_SECONDS=5
# Optional semantic retrieval. Leave disabled until a local embedding model is evaluated.
# The backend uses POST /embeddings; no model is chosen, downloaded or hosted fallback used.
OMI_EMBEDDING_ENABLED=false
OMI_EMBEDDING_BASE_URL=http://127.0.0.1:4000/v1
OMI_EMBEDDING_TOKEN=
OMI_EMBEDDING_MODEL=
# An immutable operator-supplied weights/revision identifier; change it when the alias changes.
OMI_EMBEDDING_REVISION=
OMI_EMBEDDING_DIMENSION=0
# Sentence/topic token chunks; character limits remain an additional request safety ceiling.
# Recommended initial model: Qwen/Qwen3-Embedding-0.6B, dimension1024, pinned weights revision.
# See docs/semantic-retrieval.md for explicit local CPU serving and tokenizer setup.
OMI_EMBEDDING_CHUNKING_STRATEGY=topic-token-v1
OMI_EMBEDDING_TARGET_TOKENS=320
OMI_EMBEDDING_MAX_TOKENS=512
OMI_EMBEDDING_OVERLAP_TOKENS=48
OMI_EMBEDDING_MAX_INPUT_TOKENS=8192
OMI_EMBEDDING_SPECIAL_TOKENS=8
# Supply an absolute, explicitly installed model tokenizer.json for actual token sizes.
# utf8 is a conservative UTF-8 byte bound for byte-level BPE (Qwen3), not chars/4.
OMI_EMBEDDING_TOKENIZER=utf8
OMI_EMBEDDING_TOKENIZER_REVISION=utf8-byte-bound-v1
OMI_EMBEDDING_PASSAGE_CHARS=1000
OMI_EMBEDDING_MAX_INPUT_CHARS=4000
# auto recognizes Qwen3-Embedding and E5; other models receive plain text.
OMI_EMBEDDING_QUERY_FORMAT=auto
OMI_EMBEDDING_QUERY_INSTRUCTION=Retrieve relevant personal conversation passages that answer the query
OMI_EMBEDDING_QUERY_PREFIX=
OMI_EMBEDDING_DOCUMENT_PREFIX=
# Enable only when the endpoint supports the optional dimensions request parameter.
OMI_EMBEDDING_SEND_DIMENSIONS=false
OMI_EMBEDDING_TIMEOUT_SECONDS=10
# Interactive queries have a shorter total deadline; background indexing keeps the above.
OMI_EMBEDDING_QUERY_TIMEOUT_SECONDS=2
# Query vectors only; no cached transcripts, retrieved sources or answers. RAM-only.
OMI_EMBEDDING_QUERY_CACHE_SIZE=128
OMI_EMBEDDING_QUERY_CACHE_SECONDS=300
# Avoid repeated provider timeouts during an outage; indexing retries remain independent.
OMI_EMBEDDING_QUERY_RETRY_SECONDS=15
# No uncalibrated cosine rejection; tune on dev cases and report heldout negatives.
OMI_EMBEDDING_MIN_SCORE=-1
OMI_RETRIEVAL_CANDIDATE_LIMIT=50
OMI_RETRIEVAL_RRF_K=60
OMI_RETRIEVAL_MATCHES_PER_SOURCE=3
OMI_RETRIEVAL_EVIDENCE_CHARACTER_BUDGET=12000
# Optional explicit /rerank endpoint; search works when absent or unavailable.
OMI_RERANKER_ENABLED=false
OMI_RERANKER_BASE_URL=http://127.0.0.1:4000/v1
OMI_RERANKER_MODEL=
OMI_RERANKER_TOKEN=
OMI_RERANKER_MAX_CANDIDATES=30
OMI_RERANKER_TIMEOUT_SECONDS=10
# Output language for recaps and summaries, independently of transcription.
# auto follows the source language; use a language code such as da or en to override.
OMI_SUMMARY_LANGUAGE=auto
OMI_MEETING_MAX_MINUTES=120
OMI_MARKER_CONTEXT_SECONDS=60
OMI_MARKER_AFTER_SECONDS=60
OMI_MARKER_COOLDOWN_SECONDS=60
OMI_MEETING_MIN_SECONDS=60
OMI_MEETING_CONTEXT_SECONDS=60
OMI_RECAP_HOUR=22
# Day-so-far refresh cadence; 0 disables daytime updates but keeps evening updates.
OMI_RECAP_INTERVAL_MINUTES=60
# Observed non-speech required to close a conversation; audio is retained normally.
OMI_RECAP_QUIET_MINUTES=5
OMI_WORKER_ENABLED=true
# Initial retention defaults; saved Settings choices take precedence. Zero keeps indefinitely.
OMI_AUDIO_RETENTION_DAYS=7
OMI_TRANSCRIPT_RETENTION_DAYS=30
